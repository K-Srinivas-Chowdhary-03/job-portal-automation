
# Application
PROJECT_NAME=Job Portal Automation
ENVIRONMENT=development

# PostgreSQL Database
POSTGRES_USER=your_db_username
POSTGRES_PASSWORD=your_db_password
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=job_portal

# Database URLs
DATABASE_URL=postgresql+asyncpg://your_db_username:your_db_password@postgres:5432/job_portal
SYNC_DATABASE_URL=postgresql+psycopg2://your_db_username:your_db_password@postgres:5432/job_portal

# Security / JWT
SECRET_KEY=replace_with_a_secure_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Grok / xAI
XAI_API_KEY=your_xai_api_key
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=your_configured_model

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# CORS
BACKEND_CORS_ORIGINS=http://localhost:3000
