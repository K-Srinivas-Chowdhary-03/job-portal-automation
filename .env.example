# ==============================================================================
# ENVIRONMENT CONFIGURATION - AUTOMATED JOB NOTIFICATION PLATFORM
# ==============================================================================

# Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=job_portal_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/job_portal_db
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/job_portal_db

# Security & Authentication
SECRET_KEY=generate_a_super_secret_key_at_least_32_characters_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Service (Grok API by xAI)
XAI_API_KEY=your_xai_api_key_here
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-beta

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Application URLs & CORS
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
PROJECT_NAME="Job Notification Platform"
ENVIRONMENT=development
